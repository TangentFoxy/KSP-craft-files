ship = KF-38 AA
version = 1.0.5
description = The KF-38 is a small fighter/trainer, apt for longer ranges relative to its size due to a large fuel store.¨¨The BD version contains 80 units fewer fuel storage, and has the engine in afterburning mode by default with a lower max gimbal.¨¨1. Toggle afterburner.¨2. Fire weapon.¨3. Next weapon.¨4. Deploy flares/chaff.¨0. Toggle flaps.¨¨Originally based on EJ_SA's K-38-V from KerbalX.
type = SPH
size = 9.384035,3.965399,10.33835
